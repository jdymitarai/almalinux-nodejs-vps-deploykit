# ==============================================================================
# AlmaLinux 9 Node.js VPS DeployKit - Environment Configuration Template
# Notice: Copy this file to /opt/nodeapp/shared/.env and restrict permissions:
#         chmod 600 /opt/nodeapp/shared/.env
#         chown nodeapp:nodeapp /opt/nodeapp/shared/.env
# ==============================================================================

# Application Runtime
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Database Connectivity (MariaDB on localhost)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nodeapp_db
DB_USER=nodeapp_user
DB_PASSWORD=REPLACE_WITH_STRONG_GENERATED_PASSWORD

# Security & Session Secrets
APP_SECRET=REPLACE_WITH_HEX_OR_BASE64_RANDOM_SECRET_KEY
SESSION_SECRET=REPLACE_WITH_ANOTHER_RANDOM_STRING

# CORS & Domain Settings
APP_DOMAIN=example.com
CORS_ORIGIN=https://example.com
